# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Escape newlines with \n in FIREBASE_PRIVATE_KEY
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# WebRTC STUN/TURN Server Configuration
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_USERNAME=admin_webrtc_user
TURN_CREDENTIAL=super_secret_turn_password
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Server-Side Admin Email (Bootstrap Admin Role)
ADMIN_EMAIL=admin@example.com
